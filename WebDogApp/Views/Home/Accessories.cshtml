
@{
    ViewData["Title"] = "Accessories";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Аксесоари за кучета</h1>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">

        <!-- Ergonomic Harness -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQxIv4F4uaw-I63nVsmGUajlGITE9tTjaT-esdq9Cy0pg&s=10"
                     class="card-img-top"
                     alt="Нагръдник"
                     style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title fw-bold">Ергономичен нагръдник</h5>
                    <p class="card-text fw-bold text-primary fs-5">
                        Цена: 45.00 euro
                    </p>
                </div>
            </div>
        </div>

        <!-- Automatic Leash -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://petsandyou.bg/images/thumbnails/400/400/detailed/88/ComfortPlus_L_Tape_5m_anthracite-550x550w.jpg.webp.webp"
                     class="card-img-top"
                     alt="Повод"
                     style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title fw-bold">Автоматичен повод (5м)</h5>
                    <p class="card-text fw-bold text-primary fs-5">
                        Цена: 30.00 euro
                    </p>
                </div>
            </div>
        </div>

        <!-- Orthopedic Bed -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSSHly_reklT6RI9RMxeqo7FdS-Kcg3rhXhiUXQC-dqpw&s=10"
                     class="card-img-top"
                     alt="Легло"
                     style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title fw-bold">Ортопедично легло</h5>
                    <p class="card-text fw-bold text-primary fs-5">
                        Цена: 25.00 euro
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Dog Food -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Fselectpetfood.eu%2Fwp-content%2Fuploads%2F2023%2F02%2Flg1213new2-800x1000.png&f=1&nofb=1&ipt=b7cd79d09803bc7bdf8a9d1900263c3593520ba3bf63b80c7e85946959ce4869&ipo=images"
                     class="card-img-top"
                     alt="Кучешка храна"
                     style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title fw-bold">Dog food</h5>
                    <p class="card-text fw-bold text-primary fs-5">
                        Цена: 15.00 euro
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Dog Food -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://n.nordstrommedia.com/it/ed50be4b-8390-407b-af21-d49282f4fe51.jpeg?w=780&h=1170&crop=pad&dpr=2"
                     class="card-img-top"
                     alt="Dog vest"
                     style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title fw-bold">Dog vest</h5>
                    <p class="card-text fw-bold text-primary fs-5">
                        Цена: 35.00 euro
                    </p>
                </div>
            </div>
        </div>
        
        <!-- Dog Bag -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://n.nordstrommedia.com/it/8480318c-4c30-4bae-808a-518b6a15e210.jpeg?w=780&h=1170&crop=pad&dpr=2"
                     class="card-img-top"
                     alt="Dog bag"
                     style="height: 250px; object-fit: cover;">

                <div class="card-body">
                    <h5 class="card-title fw-bold">Dog bag</h5>
                    <p class="card-text fw-bold text-primary fs-5">
                        Цена: 60.00 euro
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>
